# Environment variables and local secrets
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python build artifacts
build/
dist/
*.egg-info/

# Rasa generated files
.rasa/
models/
results/

# Node.js and Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
.npm/
.yarn/

# Logs and runtime files
*.log
*.pid
*.sqlite
*.sqlite3

# IDE and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

